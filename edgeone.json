{
  "headers": [{
        "source": "/*",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Cache-Control",
            "value": "max-age=7200"
          }
         ]}],
  "redirects": [],
  "rewrites": [],
  "caches": [
    {
      "source": "/*",
      "cacheTtl": 600
    }
  ]
}
